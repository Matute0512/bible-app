<?xml version="1.0" encoding="utf-8"?>
<!-- Same branded splash as drawable/launch_background.xml. The v21 variant is
     required by the Flutter template because windowBackground resolves color
     attributes differently on API 21+; both keep the indigo + book look. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_book" />
    </item>
</layer-list>
